{
  "name": "@reef/core-engine",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p app/tsconfig.json",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "app": "node --experimental-strip-types --no-warnings app/build.ts",
    "e2e": "node --experimental-strip-types --no-warnings app/e2e/seed.ts app/e2e/out/seed.json && node app/e2e/run.mjs",
    "simulate:peninsula": "node --experimental-strip-types --no-warnings scripts/simulate-peninsula.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run app"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "26.6.3",
    "esbuild": "0.28.2",
    "playwright": "1.63.0"
  }
}
